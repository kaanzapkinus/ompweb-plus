# OMPWeb Plus source checkout example. Contains no credentials or live URLs.
# Copy to .env.local, edit privately, then load it before the launcher starts:
# node --env-file=.env.local bin/omp-web.js
# Do not commit .env.local or any actual password/hash/token.

PORT=30177
OMP_WEB_HOSTNAME=127.0.0.1
OMP_WEB_NO_OPEN=1
OMP_WEB_NAME="OMPWeb Plus"

# Generate interactively: node bin/omp-web.js hash-password
# Uncomment and replace with the COMPLETE generated scrypt value.
# Required before binding to a non-loopback host. Also use HTTPS or encrypted VPN.
# OMP_WEB_PASSWORD_HASH='paste-generated-hash-here'

# Optional: absolute path to your separately installed OMP executable.
# OMP_WEB_OMP_BIN=

# Optional: separate private agent data root; do not point tests at live state.
# PI_CODING_AGENT_DIR=

# Optional: absolute path to separately installed cloudflared for explicit tunnels.
# OMP_WEB_CLOUDFLARED_BIN=

# Web-fork updates are manual source updates regardless of this setting.
# Set 1 to disable update checks/actions, including native OMP runtime updates.
# OMP_WEB_DISABLE_AUTOUPDATE=1

# Optional development hostname, without scheme or port. Not authentication.
# OMP_WEB_DEV_ORIGIN=dev.example.com

# Optional native extension: install/configure only via extensions/README.md.
# No chain is enabled by default. Select your own authenticated provider/models.
# OMP_AGY_FAILOVER_CHAIN='["provider-a/model-a","provider-b/model-b"]'

# Optional transcription uses your own compatible endpoint or native OMP model.
# A separate native voice bridge is deferred; no credentials are supplied here.
# OMP_WEB_STT_ENDPOINT=
# OMP_WEB_STT_KEY=
# OMP_WEB_STT_MODEL=
